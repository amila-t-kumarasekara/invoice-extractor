# Postgres
DATABASE_URL=postgresql+psycopg://invoice:invoice@localhost:5432/invoice

# Gemini (Google AI Studio API key: https://ai.google.dev/gemini-api/docs/api-key)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHEAP_MODEL=gemini-2.5-flash
STRONG_MODEL=gemini-2.5-pro

# Approximate pricing, USD per 1M tokens (input, output), <=200k-token prompt tier
# see https://ai.google.dev/gemini-api/docs/pricing - update to match your account
CHEAP_MODEL_PRICE_IN=0.30
CHEAP_MODEL_PRICE_OUT=2.50
STRONG_MODEL_PRICE_IN=1.25
STRONG_MODEL_PRICE_OUT=10.00

# Pipeline tuning
CONFIDENCE_THRESHOLD=0.75
MAX_JOB_ATTEMPTS=5
JOB_BACKOFF_BASE_SECONDS=10
OCR_TEXT_LAYER_MIN_CHARS=20
STORAGE_DIR=./storage
